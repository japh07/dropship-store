# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local files to version control

# =============================================================================
# NEXTAUTH.JS CONFIGURATION
# =============================================================================
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-256-bit-secret-key-here

# The URL of your deployed application
NEXTAUTH_URL=https://yourdomain.com

# For local development
# NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================
# Google OAuth Configuration
# Get from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# GitHub OAuth Configuration
# Get from: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# =============================================================================
# ENCRYPTION CONFIGURATION
# =============================================================================
# Generate encryption key: openssl rand -base64 32
# This key is used for AES-256 encryption of sensitive data
ENCRYPTION_KEY=your-32-byte-base64-encryption-key

# Salt for key derivation (generate random value)
ENCRYPTION_SALT=your-random-salt-value-16-bytes

# Whether to encrypt audit logs (recommended for production)
ENCRYPT_AUDIT_LOGS=true

# =============================================================================
# API CONFIGURATION
# =============================================================================
# External API URL for product data and services
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# External API key (will be encrypted automatically)
EXTERNAL_API_KEY=your-external-service-api-key

# =============================================================================
# SECURITY HEADERS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
# Log level (ERROR, WARN, INFO, DEBUG)
LOG_LEVEL=INFO

# Sentry DSN for error monitoring (optional)
SENTRY_DSN=your-sentry-dsn-here

# =============================================================================
# DEVELOPMENT/PRODUCTION SETTINGS
# =============================================================================
NODE_ENV=development
# NODE_ENV=production

# Hostname for server identification
HOSTNAME=dropship-store

# =============================================================================
# DATABASE CONFIGURATION (Future Enhancement)
# =============================================================================
# DATABASE_URL=postgresql://username:password@localhost:5432/dropshipstore

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limiting requests per window (default: 100)
RATE_LIMIT_MAX=100

# Rate limiting window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW=900000

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
# Session timeout in seconds (default: 7 days)
SESSION_MAX_AGE=604800

# Session update age in seconds (default: 1 day)
SESSION_UPDATE_AGE=86400

# =============================================================================
# CSRF PROTECTION
# =============================================================================
# CSRF secret (generate: openssl rand -hex 32)
CSRF_SECRET=your-csrf-secret-here

# =============================================================================
# CONTENT SECURITY POLICY
# =============================================================================
# Additional CSP directives (comma-separated)
CSP_DIRECTIVES=script-src 'self' 'unsafe-inline' https://vercel.live

# =============================================================================
# SECURITY MONITORING
# =============================================================================
# Webhook URL for security alerts (optional)
SECURITY_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email for security notifications (optional)
SECURITY_EMAIL=admin@yourdomain.com

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================
# Backup encryption key (generate: openssl rand -base64 32)
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# =============================================================================
# INSTRUCTIONS FOR SETUP
# =============================================================================

# 1. Generate secure secrets:
#    - NEXTAUTH_SECRET: `openssl rand -base64 32`
#    - ENCRYPTION_KEY: `openssl rand -base64 32`
#    - ENCRYPTION_SALT: `openssl rand -hex 16`
#    - CSRF_SECRET: `openssl rand -hex 32`

# 2. Set up OAuth providers:
#    - Google: https://console.developers.google.com/
#    - GitHub: https://github.com/settings/applications/new
#    - Add authorized redirect URIs for each provider

# 3. Configure security headers:
#    - Update ALLOWED_ORIGINS with your domains
#    - Customize CSP directives as needed

# 4. Set up monitoring:
#    - Configure SENTRY_DSN for error tracking
#    - Set up SECURITY_WEBHOOK_URL for alerts
#    - Configure SECURITY_EMAIL for notifications

# 5. Database setup (when implementing):
#    - Configure DATABASE_URL
#    - Run database migrations
#    - Set up database backups

# 6. Production deployment:
#    - Set NODE_ENV=production
#    - Configure HTTPS/SSL certificates
#    - Set up proper CORS origins
#    - Enable all security features

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================

# • NEVER commit .env.local to version control
# • Use different keys for development and production
# • Rotate keys regularly (recommended: every 90 days)
# • Use strong, randomly generated secrets
# • Enable all security headers in production
# • Monitor security logs regularly
# • Keep dependencies updated
# • Regular security audits and penetration testing
# • Implement proper backup and recovery procedures